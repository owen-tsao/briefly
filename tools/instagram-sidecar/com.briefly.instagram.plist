<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.briefly.instagram</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOU/briefly/tools/instagram-sidecar/.venv/bin/python</string>
    <string>/Users/YOU/briefly/tools/instagram-sidecar/poll.py</string>
  </array>
  <!-- Hourly, plus 0–4 min of jitter inside poll.py. The first account ran at 30 min and was
       flagged for scraping within four days, so this is a floor, not a tuning knob: ~24
       read-only requests a day. Stories live 24h, so hourly still catches them. -->
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/YOU/Library/Logs/briefly-instagram.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOU/Library/Logs/briefly-instagram.log</string>
</dict>
</plist>
